# ==============================================================================
# CoachOS - Environment Configuration Template
# ==============================================================================
# SAFE DEVELOPER DEFAULTS - DO NOT COMMIT REAL CREDENTIALS
# ==============================================================================

# --- DJANGO BACKEND SETTINGS ---
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=django-insecure-dev-key-phase04-testing-only-change-in-prod
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend,0.0.0.0

# --- DATABASE (PostgreSQL 16) ---
DATABASE_URL=postgres://coachos:coachos_dev_pw@localhost:5432/coachos_db
DB_NAME=coachos_db
DB_USER=coachos
DB_PASSWORD=coachos_dev_pw
DB_HOST=localhost
DB_PORT=5432

# --- CACHE & TASK BROKER (Redis 7) ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- CORS & CSRF ALLOWED ORIGINS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000

# --- S3 MEDIA STORAGE (ABSTRACT / LOCAL DEV MINIO) ---
S3_ENABLED=False
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_MEDIA=coachos-media-private-dev
S3_BUCKET_PROGRESS=coachos-progress-private-dev
S3_REGION_NAME=eu-central-1

# --- SENTRY OBSERVABILITY (OPTIONAL / STAGING) ---
SENTRY_DSN=
ENVIRONMENT=development

# --- PHASE 11 AI COPILOT (GOVERNED, DEFAULT DISABLED) ---
# Kill switch (default False; enabled only for local dev/eval):
COPILOT_ENABLED=False
# Provider selection is configuration-only. Only the deterministic fake adapter
# is implemented in this branch. Any other value fails closed (no silent fallback).
# NEVER put provider API keys in this file or any NEXT_PUBLIC_ variable.
COPILOT_PROVIDER=fake-deterministic
COPILOT_RATE_LIMIT_PER_MINUTE=10
COPILOT_DAILY_RUN_QUOTA_PER_ACTOR=20
COPILOT_DAILY_RUN_QUOTA_PER_ORG=100
COPILOT_DAILY_COST_CAP_MICRO_USD=5000000
COPILOT_CONTEXT_RETENTION_DAYS=30
COPILOT_MAX_ATTEMPTS=2

# --- FRONTEND PUBLIC RUNTIME CONFIG (NEXT_PUBLIC_ ONLY) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=CoachOS
NEXT_PUBLIC_DEFAULT_LOCALE=fa-IR
NEXT_PUBLIC_SUPPORTED_LOCALES=fa-IR,en-US
NEXT_PUBLIC_SENTRY_DSN_PUBLIC=

# --- PHASE 10 LOCAL BILLING TEST ADAPTER (NO LIVE MONEY MOVEMENT) ---
BILLING_DEFAULT_PROVIDER=fake
BILLING_FAKE_WEBHOOK_SECRET=replace-with-a-local-random-test-value
BILLING_WEBHOOK_TOLERANCE_SECONDS=300
BILLING_FRONTEND_BASE_URL=http://localhost:3000
BILLING_HOSTED_URL_ALLOWED_HOSTS=payments.test.coachos.invalid,invoices.test.coachos.invalid
